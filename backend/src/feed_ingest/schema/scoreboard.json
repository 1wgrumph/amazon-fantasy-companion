{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "afc.espn-scoreboard.v1",
  "description": "Pinned subset of the ESPN NFL scoreboard body that P2-B02 reads (spikes/sp5-espn-feed/VERDICT.md).",
  "type": "object",
  "required": ["events"],
  "properties": {
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": {"type": "string", "pattern": "^[0-9]{1,20}$"},
          "status": {
            "type": "object",
            "properties": {
              "type": {"type": "object", "properties": {"state": {"type": "string"}}}
            }
          }
        }
      }
    }
  }
}
