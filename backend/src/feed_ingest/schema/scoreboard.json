{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "afc.espn-scoreboard.v1",
  "description": "Pinned subset of the ESPN NFL scoreboard body that P2-B02 reads (spikes/sp5-espn-feed/VERDICT.md).",
  "type": "object",
  "required": [
    "events"
  ],
  "properties": {
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9]{1,20}$"
          },
          "status": {
            "type": "object",
            "properties": {
              "type": {
                "type": "object",
                "properties": {
                  "state": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "competitions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "competitors": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "team": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "abbreviation": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "id"
                        ]
                      }
                    },
                    "required": [
                      "team"
                    ]
                  }
                },
                "leaders": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "leaders": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "athlete": {
                              "type": "object",
                              "properties": {
                                "id": {
                                  "type": "string"
                                }
                              },
                              "required": [
                                "id"
                              ]
                            }
                          },
                          "required": [
                            "athlete"
                          ]
                        }
                      }
                    },
                    "required": [
                      "leaders"
                    ]
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
