{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "afc.espn-summary.v1",
  "description": "Pinned subset of the ESPN NFL summary body that P2-B02 reads (spikes/sp5-espn-feed/VERDICT.md). Unknown fields are allowed; read fields are required and typed.",
  "type": "object",
  "required": ["header", "drives"],
  "properties": {
    "header": {
      "type": "object",
      "required": ["id", "competitions"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "competitions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "broadcasts": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["media"],
                  "properties": {
                    "media": {
                      "type": "object",
                      "required": ["shortName"],
                      "properties": {"shortName": {"type": "string"}}
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "drives": {
      "type": "object",
      "required": ["previous"],
      "properties": {
        "previous": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {"plays": {"type": "array", "items": {"$ref": "#/$defs/play"}}}
          }
        }
      }
    },
    "boxscore": {
      "type": "object",
      "properties": {
        "players": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "statistics": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "athletes": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": ["athlete"],
                        "properties": {
                          "athlete": {
                            "type": "object",
                            "required": ["id"],
                            "properties": {"id": {"type": "string"}}
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "play": {
      "type": "object",
      "required": ["id", "awayScore", "homeScore", "start", "period", "scoringPlay"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "awayScore": {"type": "integer"},
        "homeScore": {"type": "integer"},
        "wallclock": {"type": ["string", "null"]},
        "period": {
          "type": "object",
          "required": ["number"],
          "properties": {"number": {"type": "integer", "minimum": 1}}
        },
        "scoringPlay": {"type": "boolean"},
        "start": {
          "type": "object",
          "required": ["yardsToEndzone"],
          "properties": {"yardsToEndzone": {"type": "integer"}}
        },
        "teamParticipants": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id"],
            "properties": {"id": {"type": "string"}, "type": {"type": "string"}}
          }
        },
        "participants": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "athlete": {"type": "object", "properties": {"id": {"type": "string"}}}
            }
          }
        }
      }
    }
  }
}
