<mxfile host="azdiagram">
  <diagram id="watch-flow" name="Alert to Watch: derived operational sequence">
    <mxGraphModel pageWidth="760" pageHeight="380">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="be" value="Backend policy / resolver" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;">
          <mxGeometry x="20" y="20" width="120" height="40" as="geometry" />
        </mxCell>
        <mxCell id="tv" value="TV notifier / launcher" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;">
          <mxGeometry x="220" y="20" width="120" height="40" as="geometry" />
        </mxCell>
        <mxCell id="user" value="Customer" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;">
          <mxGeometry x="420" y="20" width="120" height="40" as="geometry" />
        </mxCell>
        <mxCell id="provider" value="Provider app" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;">
          <mxGeometry x="620" y="20" width="120" height="40" as="geometry" />
        </mxCell>
        <mxCell id="life-be" value="" edge="1" parent="1" style="html=1;endArrow=none;dashed=1;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="80" y="60" as="sourcePoint" />
            <mxPoint x="80" y="360" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="life-tv" value="" edge="1" parent="1" style="html=1;endArrow=none;dashed=1;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="280" y="60" as="sourcePoint" />
            <mxPoint x="280" y="360" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="life-user" value="" edge="1" parent="1" style="html=1;endArrow=none;dashed=1;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="480" y="60" as="sourcePoint" />
            <mxPoint x="480" y="360" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="life-provider" value="" edge="1" parent="1" style="html=1;endArrow=none;dashed=1;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="680" y="60" as="sourcePoint" />
            <mxPoint x="680" y="360" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="msg-1" value="gated, delayed Alert + route" edge="1" parent="1" style="html=1;" source="be" target="tv">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="80" y="110" as="sourcePoint" />
            <mxPoint x="280" y="110" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="msg-2" value="chosen presentation: Watch / Dismiss" edge="1" parent="1" style="html=1;" source="tv" target="user">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="280" y="160" as="sourcePoint" />
            <mxPoint x="480" y="160" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="msg-3" value="Watch; confirmation if configured" edge="1" parent="1" style="html=1;" source="user" target="tv">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="480" y="210" as="sourcePoint" />
            <mxPoint x="280" y="210" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="msg-4" value="supported game/channel URI or intent" edge="1" parent="1" style="html=1;" source="tv" target="provider">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="280" y="260" as="sourcePoint" />
            <mxPoint x="680" y="260" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="msg-5" value="reported RoutingOutcome; unknown stays unknown" edge="1" parent="1" style="html=1;" source="tv" target="user">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="280" y="310" as="sourcePoint" />
            <mxPoint x="480" y="310" as="targetPoint" />
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
