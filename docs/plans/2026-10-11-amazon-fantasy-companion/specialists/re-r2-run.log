from pathlib import Path
import hashlib,re
p=Path('docs/plans/2026-10-11-amazon-fantasy-companion')
f=p/'amazon-fantasy-companion-technical-plan.md'
expected='b0f42a1b844e7b40917c46fd5afcf790d6c78bb2cb41760a1c3cc3420ca5b693'
assert hashlib.sha256(f.read_bytes()).hexdigest()==expected
