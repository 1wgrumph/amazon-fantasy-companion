/bin/bash -lc "python3 -B - <<'PY'
from pathlib import Path
import re, hashlib, subprocess, os, importlib.util
p=Path('docs/plans/2026-10-11-amazon-fantasy-companion')
candidate=p/'amazon-fantasy-companion-technical-plan.md'
new=candidate.read_text()
lines=new.splitlines(keepends=True)
diff=(p/'specialists/re-r1-applied.diff').read_text().splitlines(keepends=True)
hunks=[]
i=0
while i<len(diff):
 m=re.fullmatch(r'(\\d+)(?:,(\\d+))?([acd])(\\d+)(?:,(\\d+))?\\n?',diff[i]); assert m,repr(diff[i])
 a,b,op,c,d=m.groups(); assert op=='c',op
 i+=1; old=[]; fresh=[]
 while i<len(diff) and diff[i].startswith('< '): old.append(diff[i][2:]); i+=1
 assert diff[i]=='---\\n'; i+=1
 while i<len(diff) and diff[i].startswith('> '): fresh.append(diff[i][2:]); i+=1
 start,end=int(c)-1,int(d or c)
 assert lines[start:end]==fresh,(c,d)
 hunks.append((start,end,old))
original=lines[:]
for start,end,old in reversed(hunks): original[start:end]=old
old=''.join(original)
sha=hashlib.sha256(old.encode()).hexdigest(); assert sha=='b3b23146b59109ba83f89600d5b601076b348998235ad722cd0348d60e45d461',sha
print('Reverse-diff reconstruction matches round-0 SHA-256:',sha)
def rows(s):
 out={}
 for line_no,line in enumerate(s.splitlines(),1):
  if re.match(r'\\| (?:AC|RISK)-AFC-',line):
   cells=[x.strip() for x in line.strip('|').split('|')]
   assert cells[0] not in out,cells[0]
   out[cells[0]]=(line_no,cells)
 return out
before,after=rows(old),rows(new)
assert set(before)==set(after) and len(after)==81
r0=(p/'specialists/requirements-engineer-receipt.md').read_text()
sections=re.findall(r'"'^### ((?:AC|RISK)-AFC-[A-Z0-9-]+)'"\\n(.*?)(?="'^### |''^## |'"\\Z)',r0,re.M|re.S)
assert len(sections)==46
counts={'statements':0,'allocation':0,'source':0,'verification':0,'risk_rationale_preserved':0,'risk_response_preserved':0}
for uid,section in sections:
 proposal=next(x for x in section.splitlines() if x.startswith('| '+uid+' |'))
 text=proposal.strip('|').split('|')[-1].strip()
 n,cells=after[uid]; oldcells=before[uid][1]
 assert cells[1]==text,(uid,'statement')
 counts['statements']+=1
 for label,column in [('Source',2),('Verification',3),('Allocation',4)]:
  match=re.search(label+r' → "'`(.+?)`'"\\.',section)
  if match:
   assert cells[column]==match[1],(uid,label,cells[column],match[1])
   counts[label.lower()]+=1
  elif uid.startswith('AC-') and not(uid=='AC-AFC-LAND-01' and label=='Source') and not(uid=='AC-AFC-SPEC-02' and label=='Source'):
   assert cells[column]==oldcells[column],(uid,label,'unrequested mutation')
 if uid.startswith('RISK-'):
  assert len(cells)==7
  assert cells[5]==oldcells[1],(uid,'rationale')
  assert cells[6]==oldcells[3],(uid,'response')
  counts['risk_rationale_preserved']+=1; counts['risk_response_preserved']+=1
assert after['AC-AFC-SPEC-02'][1][2]==before['AC-AFC-SPEC-02'][1][2]+', COE-ASA-001'
assert after['AC-AFC-LAND-01'][1][2]=='Workspace cross-repo rules 4 and 9; Worktrees \"Never squash-merge\"; this plan §Program plan and §Rollback or repair'
repaired={uid for uid,_ in sections}
passed=set(after)-repaired
assert len(passed)==35
assert all(after[uid][1]==before[uid][1] for uid in passed)
changed={uid for uid in after if after[uid][1]"'!=before[uid][1]}
assert changed==repaired,(changed''^repaired)
print('"'Exact proposal/metadata checks:',counts,'plus SPEC-02 and LAND-01 sources')
print('Previously passing rows unchanged: 35/35; changed rows: 46/46; unique row inventory: 81')
linter=Path.home()/'alphazede/Alphazedehq/tools/coe/lint-sdoc.py'
proc=subprocess.run(['python3','-B',str(p/'specialists/ac_mechanical_lint.py'),str(linter),str(candidate)],env={**os.environ,'PYTHONDONTWRITEBYTECODE':'1'},capture_output=True,text=True)
assert proc.returncode==0,proc.stderr
assert proc.stdout==(p/'specialists/ac-mechanical-lint-r1.txt').read_text()
print('Existing adapter reproduction: exit=0, byte-identical output;',proc.stdout.splitlines()[-1])
spec=importlib.util.spec_from_file_location('sdoc_lint',linter);mod=importlib.util.module_from_spec(spec);spec.loader.exec_module(mod)
print('Supplemental RISK checks: same adapter rule constants, all five requirement fields plus rationale and response')
for uid,(n,cells) in after.items():
 if not uid.startswith('RISK-'): continue
 statement=cells[1]; issues=[]
 prefix=next((x for x in mod.EARS_PREFIXES if statement.startswith(x[0])),None)
 if not prefix:issues.append('no EARS prefix')
 elif prefix[1] and prefix[1] not in statement:issues.append('conditional form')
 if ' shall ' not in statement:issues.append('no shall')
 for modal in [' should ',' may ']:
  if modal in statement:issues.append('weak modal')
 for term in mod.BANNED_TERMS:
  if re.search(r'(?<"'![a-z])'"'+re.escape(term)+r'(?"'![a-z])'"',statement.lower()):issues.append('banned:'+term)
 for term in mod.AGNOSTIC_TERMS:
