    SA["Alphazedehq:skills/spec-authoring/<br/>SKILL.md, references/, template/,<br/>scripts/spec_build.py, scripts/spec_lint.py, scripts/azdiagram/<br/>PEP 723 inline deps via uv run --script; Graphviz dot external"]
