"""S06: real template, Graphviz and git-backed vendoring contracts."""
import os
from pathlib import Path
import shutil
import subprocess
import sys

import yaml

SKILL = Path(__file__).resolve().parents[1]


def run(*args, **kwargs):
    return subprocess.run(args, text=True, capture_output=True, **kwargs)


def test_template_build_lint_and_diagram_outside_git(tmp_path):
    source = tmp_path / 'spec'
    shutil.copytree(SKILL / 'template', source)
    assert run('git', '-C', str(tmp_path), 'rev-parse', '--git-dir').returncode != 0
    for script, args in (
        ('spec_build.py', [str(source), str(tmp_path / 'first.md')]),
        ('spec_build.py', [str(source), str(tmp_path / 'second.md')]),
        ('spec_lint.py', [str(source)]),
        ('diagram.py', ['lint', str(source)]),
        ('diagram.py', ['render', str(source / 'figures/system-context.yaml')]),
    ):
        result = run(sys.executable, str(SKILL / 'scripts' / script), *args)
        assert result.returncode == 0, result.stdout + result.stderr
    assert (tmp_path / 'first.md').read_bytes() == (tmp_path / 'second.md').read_bytes()
    assert (source / 'figures/system-context.svg').is_file()
    assert (source / 'figures/system-context.drawio').is_file()


def test_missing_dot_is_typed_gap(tmp_path):
    result = run(sys.executable, str(SKILL / 'scripts/diagram.py'), 'lint',
                 str(SKILL / 'template'), env={**os.environ, 'PATH': str(tmp_path)})
    assert result.returncode == 3
    assert 'TOOL_MISSING' in result.stderr


def test_trigger_boundary_and_requirement_method_reference():
    text = (SKILL / 'SKILL.md').read_text()
    description = yaml.safe_load(text.split('---', 2)[1])['description']
    assert 'Do not use for SDoc' in description
    assert 'StrictDoc or Requirements System documents' in description
    assert 'requirements-engineering' in text


def test_vendor_copy_provenance_and_modified_copy_refusal(tmp_path):
    vendor = SKILL / 'scripts/vendor.sh'
    result = run('bash', str(vendor), str(tmp_path))
    assert result.returncode == 0, result.stderr
    target = tmp_path / 'tools/spec'
    notice = (target / 'VENDORED.md').read_text()
    commit = run('git', '-C', str(SKILL), 'log', '-1', '--format=%H', '--', '.').stdout.strip()
    tree = run('git', '-C', str(SKILL), 'rev-parse', f'{commit}:skills/spec-authoring').stdout.strip()
    assert f'Source commit: {commit}' in notice
    assert f'Skill tree: {tree}' in notice
    assert 'Source repository: https://github.com/alphazede/Alphazedehq' in notice
    assert 'Permission is hereby granted' in notice
    assert (target / 'template/spec.yaml').read_bytes() == (SKILL / 'template/spec.yaml').read_bytes()
    assert (target / 'spec_build.py').read_bytes() == (SKILL / 'scripts/spec_build.py').read_bytes()
    assert run('bash', str(vendor), str(tmp_path)).returncode == 0
    edited = target / 'spec_build.py'
    edited.write_text(edited.read_text() + '\n# downstream change\n')
    before = edited.read_bytes()
    refusal = run('bash', str(vendor), str(tmp_path))
    assert refusal.returncode != 0
    assert 'modified vendored copy' in refusal.stderr
    assert edited.read_bytes() == before
