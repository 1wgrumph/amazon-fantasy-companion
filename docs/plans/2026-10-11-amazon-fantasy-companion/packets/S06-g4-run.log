## Developer feedback

Used for: portable Markdown specification skill authoring and verification.
Worked well: installed creator initializer and stock metadata validator; pinned BRAN validation; offline wheel resolution; fresh Read-only routing evaluator.
Needs work: agnostic command scans bytecode it causes Python to generate; vendor path handling requires an implementation correction.
Onboarding zero-to-hello-world: unknown (not measured).
Would build again: Yes, existing source tests and explicit command contracts expose actionable failures.
AWS: n/a.
Friction: task S06 verification; steps run pytest then the prescribed agnostic command; expected exit 0 for portable source, actual generated-bytecode matches; severity Blocker; workaround not applied because plan-command edits are prohibited; suggestion restrict the path scan to shipped source files or specify a bytecode-free environment.
Feature requests: n/a; this is a command correction, not new functionality.

bran_status: hit (stock validation pattern); spec-authoring query term initially unmatched. BRAN check passed through the verified trusted HQ runtime. Bounded raw reads were needed for named plan sections, source code, and failure output.

No independent assurance, reciprocal routing result, complete supply-chain proof, successful vendoring or PR handoff is claimed.

Exact expanded verification commands: commands.txt.
#!/usr/bin/env python3
"""Validate the skill and check independent forward-test classifications.

Set SPEC_AUTHORING_TRIGGER_RESULTS to the evaluator's JSON (case id -> MATCH/NO_MATCH).
Give the evaluator SKILL.md and trigger-requests.json without this checker.
"""

import json
import os
from pathlib import Path
import subprocess
import sys
import tempfile
import unittest

import yaml


SKILL = Path(os.environ.get("SPEC_AUTHORING_SKILL_DIR", Path(__file__).resolve().parents[1]))
CREATOR = Path.home() / ".codex/skills/.system/skill-creator/scripts/quick_validate.py"


class SpecAuthoringTests(unittest.TestCase):
    def test_creator_validation_and_repository_metadata(self):
        text = (SKILL / "SKILL.md").read_text()
        self.assertLess(len(text.splitlines()), 60)
        self.assertLess(len(text.split()), 650)
        self.assertNotIn("[TODO]", text)
        _, header, body = text.split("---", 2)
        metadata = yaml.safe_load(header)
        self.assertEqual(metadata["name"], "spec-authoring")
        for field in ("type", "title", "okf_status", "tags"):
            self.assertTrue(metadata[field], field)
        # The installed validator rejects HQ metadata. Validate its portable
        # fields unchanged; BRAN validates the complete repository document.
        portable = {key: value for key, value in metadata.items() if key in
                    {"name", "description", "license", "allowed-tools", "metadata"}}
        with tempfile.TemporaryDirectory() as target:
            Path(target, "SKILL.md").write_text(
                "---\n" + yaml.safe_dump(portable) + "---" + body)
            subprocess.run([sys.executable, str(CREATOR), target], check=True)

    def test_trigger_classifications(self):
        requests = json.loads((Path(__file__).parent / "trigger-requests.json").read_text())
        results = json.loads(Path(os.environ["SPEC_AUTHORING_TRIGGER_RESULTS"]).read_text())
        self.assertEqual(set(results), set(requests))
        self.assertEqual(results, {"request_1": "MATCH", "request_2": "NO_MATCH"})


if __name__ == "__main__":
    unittest.main()
def test_vendor_copy_provenance_and_modified_copy_refusal(tmp_path):
    vendor = SKILL / 'scripts/vendor.sh'
    result = run('bash', str(vendor), str(tmp_path))
    assert result.returncode == 0, result.stderr
    target = tmp_path / 'tools/spec'
    notice = (target / 'VENDORED.md').read_text()
    commit = run('git', '-C', str(SKILL), 'log', '-1', '--format=%H', '--', '.').stdout.strip()
    tree = run('git', '-C', str(SKILL), 'rev-parse', f'{commit}:skills/spec-authoring').stdout.strip()
    assert f'Source commit: {commit}' in notice
    assert f'Skill tree: {tree}' in notice
    assert 'Source repository: https://github.com/alphazede/Alphazedehq' in notice
    assert 'Permission is hereby granted' in notice
    assert (target / 'template/spec.yaml').read_bytes() == (SKILL / 'template/spec.yaml').read_bytes()
    assert (target / 'spec_build.py').read_bytes() == (SKILL / 'scripts/spec_build.py').read_bytes()
    assert run('bash', str(vendor), str(tmp_path)).returncode == 0
    edited = target / 'spec_build.py'
    edited.write_text(edited.read_text() + '\n# downstream change\n')
    before = edited.read_bytes()
    refusal = run('bash', str(vendor), str(tmp_path))
    assert refusal.returncode != 0
    assert 'modified vendored copy' in refusal.stderr
    assert edited.read_bytes() == before
