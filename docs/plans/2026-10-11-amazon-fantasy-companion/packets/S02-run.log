#!/usr/bin/env python3
"""Focused contract and activation tests for create-lean-skill."""

from __future__ import annotations

import json
from pathlib import Path
import subprocess
import sys
import unittest


SKILL_DIR = Path(__file__).resolve().parents[1]
SKILL = SKILL_DIR / "SKILL.md"
HOOK = SKILL_DIR / "scripts" / "user_prompt_submit.py"


def invoke(prompt: str, event: str = "UserPromptSubmit") -> str:
    payload = json.dumps({"hook_event_name": event, "prompt": prompt})
    result = subprocess.run(
        [sys.executable, str(HOOK)],
        input=payload,
        text=True,
        capture_output=True,
        check=True,
    )
    return result.stdout.strip()


class CreateLeanSkillTests(unittest.TestCase):
    def test_core_contract_stays_lean(self) -> None:
        text = SKILL.read_text(encoding="utf-8")
        self.assertLess(len(text.splitlines()), 60)
        self.assertLessEqual(len(text.split()), 650)
        for term in ("preconditions", "Algorithm", "validation", "recovery", "Outcomes"):
            self.assertIn(term, text)

    def test_matching_request_activates(self) -> None:
        output = invoke("Rebuild our router SKILL.md from scratch")
        context = json.loads(output)["hookSpecificOutput"]["additionalContext"]
        self.assertIn("$create-lean-skill", context)
        self.assertIn("bounded, typed, testable", context)

    def test_non_matching_request_stays_dormant(self) -> None:
        self.assertEqual(invoke("Improve the authentication service"), "")


if __name__ == "__main__":
    unittest.main()
