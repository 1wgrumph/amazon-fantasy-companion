\"\"\"AC-AFC-CI-02: exercise the real checker process with YAML workflow fixtures.\"\"\"

from pathlib import Path
import subprocess
import sys

import pytest


SKILL = Path(__file__).resolve().parents[1]
TEMPLATE = (SKILL / 'templates/ci.yml').read_text()
CHECKER = SKILL / 'scripts/check-workflows.py'


def invoke(*paths):
    return subprocess.run([sys.executable, str(CHECKER), *map(str, paths)],
                          capture_output=True, text=True, check=False)


def test_shipped_template_passes():
    result = invoke(SKILL / 'templates/ci.yml')
    assert result.returncode == 0, result.stderr
    assert 'PASS' in result.stdout


@pytest.mark.parametrize(('before', 'after', 'diagnostic'), [
    ('pull_request:', 'pull_request_target:', 'triggers'),
    ('branches: [main]', 'branches: [other]', 'triggers'),
    ('  push:', '  workflow_dispatch:\\n  push:', 'triggers'),
    ('"'${{ github.ref }}'"', 'fixed', 'concurrency'),
    ('cancel-in-progress: true', 'cancel-in-progress: false', 'concurrency'),
    (\""'${{ needs.changes.outputs.code == '"'true' }}\", 'true', 'paths condition'),
    (\""'${{ needs.changes.outputs.code == '"'true' }}\", \""'${{ needs.changes.outputs.code == '"'true' || true }}\", 'paths condition'),
    ('"'${{ steps.filter.outputs.code }}'"', \""'${{ '"'true' }}\", 'outputs'),
    ('needs: changes', 'needs: other', 'paths condition'),
    (\"token: ''\", 'token: "'${{ github.token }}'"', 'git fallback'),
    ('fetch-depth: 0', 'fetch-depth: 1', 'full checkout'),
    ('gate / code', 'gate / "'${{ github.ref }}'"', 'stable'),
    ('gate / code', 'gate / hygiene', 'stable'),
    ('    name: gate / code', '    strategy:\\n      matrix: {version: [1, 2]}\\n    name: gate / code', 'matrix'),
    ('actions/checkout@93cb6efe18208431cddfb8368fd83d5badbf9bfd', 'actions/checkout@v5', 'full commit SHA'),
    ('dorny/paths-filter@0e4a8c6effa4802afeda77dc8d303f8176d7dfad', 'dorny/paths-filter@v3', 'full commit SHA'),
    ('contents: read', 'contents: write', 'permissions'),
    ('    name: gate / code', '    permissions: {contents: write}\\n    name: gate / code', 'permissions'),
    ('bash tools/ci/gate.sh --area code', 'echo "'${{ secrets.TOKEN }}'"', 'secrets'),
    ('bash tools/ci/gate.sh --area code', \"echo "'${{ secrets['"'TOKEN'] }}\", 'secrets'),
    ('persist-credentials: false', 'persist-credentials: true', 'persist credentials'),
    ('ubuntu-latest', 'self-hosted', 'runners'),
    ('ubuntu-latest', 'ubuntu-custom-host', 'runners'),
    ('    name: gate / code', '    environment: production\\n    name: gate / code', 'environment'),
    ('    name: gate / hygiene', '    if: false\\n    name: gate / hygiene', 'unconditionally'),
], ids=['target-event', 'push-branch', 'extra-event', 'concurrency-ref', 'cancel',
        'area-unconditional', 'condition-bypass', 'output-bypass', 'dependency',
        'filter-token', 'shallow-checkout', 'dynamic-name', 'duplicate-name', 'matrix',
        'checkout-tag', 'filter-tag', 'workflow-write', 'job-write', 'secret-dot',
        'secret-bracket', 'persist-token', 'self-hosted', 'custom-runner',
        'environment', 'conditional-hygiene'])
def test_rule_violation_exits_one(tmp_path, before, after, diagnostic):
    assert before in TEMPLATE
    workflow = tmp_path / 'violating.yml'
    workflow.write_text(TEMPLATE.replace(before, after))
    result = invoke(workflow)
    assert result.returncode == 1, result.stdout + result.stderr
    assert diagnostic in result.stderr


@pytest.mark.parametrize('content', ['', 'jobs: [', 'jobs: []', 'jobs: {}\\njobs: {}',
                                      '[]', 'on: push\\njobs: {changes: null}'])
def test_malformed_workflow_fails_closed(tmp_path, content):
    path = tmp_path / 'malformed.yml'
    path.write_text(content)
    result = invoke(path)
    assert result.returncode == 1
    assert 'Traceback' not in result.stderr


def test_missing_file_and_multiple_workflows_fail(tmp_path):
    result = invoke(SKILL / 'templates/ci.yml', tmp_path / 'missing.yml')
    assert result.returncode == 1
    assert 'PASS' in result.stdout
    assert 'unreadable' in result.stderr


def test_missing_arguments_is_usage_error():
    assert invoke().returncode == 2
