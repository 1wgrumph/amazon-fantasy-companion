#!/usr/bin/env python3
"""Validate the skill and check independent forward-test classifications.

Set RELEASE_TRIGGER_RESULTS to the evaluator's JSON (case id -> MATCH/NO_MATCH).
Give the evaluator SKILL.md and trigger-requests.json without this checker.
"""

import json
import os
from pathlib import Path
import subprocess
import sys
import tempfile
import unittest

import yaml


SKILL = Path(os.environ.get("RELEASE_SKILL_DIR", Path(__file__).resolve().parents[1]))
CREATOR = Path.home() / ".codex/skills/.system/skill-creator/scripts/quick_validate.py"


class ReleaseProcessTests(unittest.TestCase):
    def test_creator_validation_and_repository_metadata(self):
        text = (SKILL / "SKILL.md").read_text()
        self.assertLess(len(text.splitlines()), 60)
        self.assertLess(len(text.split()), 400)
        _, header, body = text.split("---", 2)
        metadata = yaml.safe_load(header)
        self.assertEqual(metadata["name"], "release-process")
        for field in ("type", "title", "okf_status", "tags"):
            self.assertTrue(metadata[field], field)
        # The installed validator rejects HQ metadata. Validate its portable
        # fields unchanged; BRAN validates the complete repository document.
        portable = {key: value for key, value in metadata.items() if key in
                    {"name", "description", "license", "allowed-tools", "metadata"}}
        with tempfile.TemporaryDirectory() as target:
            Path(target, "SKILL.md").write_text(
                "---\n" + yaml.safe_dump(portable) + "---" + body)
            subprocess.run([sys.executable, str(CREATOR), target], check=True)

    def test_trigger_classifications(self):
        requests = json.loads((Path(__file__).parent / "trigger-requests.json").read_text())
        results = json.loads(Path(os.environ["RELEASE_TRIGGER_RESULTS"]).read_text())
        self.assertEqual(set(results), set(requests))
        self.assertEqual(results, {"request_1": "MATCH", "request_2": "NO_MATCH"})


if __name__ == "__main__":
    unittest.main()
{
  "request_1": "cut a release of alphazede/azedge",
  "request_2": "open a PR"
}

