#!/usr/bin/env bash
# Local merge gate for alphazede/Alphazedehq (the requirements-system model:
# tools/ci/local-gates.sh there, #333). This script is the merge check before
# pushing; .github/workflows/coe-gates.yml covers only a subset of these gates.
#
# Usage:
#   bash tools/ci/local-gates.sh             # every gate whose paths changed
#   bash tools/ci/local-gates.sh --fast      # skip the slow gates (never writes a receipt)
#   bash tools/ci/local-gates.sh --full      # run every gate whatever changed
#   bash tools/ci/local-gates.sh --list      # print the gate list and exit
#   bash tools/ci/local-gates.sh --self-test # check the path filters and lanes
#   GATE_TIMEOUT=600 bash tools/ci/local-gates.sh  # per-gate timeout (default 600s)
#
# Each gate reports PASS, FAIL, SKIP (deliberately not run: --fast) or N/A
# (not applicable: none of the gate's paths changed since the merge-base with
# origin/main). Baseline diff and secret checks always run. Exit 0 only when
# no gate failed. A change to this runner, the standards validator, or the
# workflows runs every gate, as does a checkout
# with no merge-base or with an empty change set (main itself).
#
# Gates run in three concurrent lanes; the gates inside one lane run one after
# another. Lane A holds the alphazede-web steps, which share node_modules.
# Lane B holds the visual-review browser suite, the one slow gate. Lane C is
# the rest: the COE lints, the standards YAML validation, and the hook and TE
# suites.
#
# The StrictDoc bridge step stays out, as in CI: it runs the packaged engine
# from /usr/lib/alphazede-requirements-system, which is an installed Debian
# payload on an owner node and is not available to every runner. The bridge
# stays a local step via tools/coe/validate-sdoc.sh; what runs here is the
# part that is reproducible anywhere.
#
# Receipt: when at least one gate passed, none failed or skipped, on a checkout
# whose tracked files are clean, the run writes
#   ${AZ_GATE_RECEIPTS:-~/.local/state/alphazede-gate-receipts}/Alphazedehq/<HEAD sha>
# hooks/merge-gate-guard.py refuses `gh pr merge` for this repository unless
# the PR head SHA has that receipt. GitHub Actions is disabled here, so
# .github/workflows/coe-gates.yml never runs; this receipt is the merge check.

set -uo pipefail
cd "$(git rev-parse --show-toplevel)" || exit 2
# Gates import modules from the tree; a run must leave no __pycache__ behind.
export PYTHONDONTWRITEBYTECODE=1

FAST=0 FULL=0 LIST=0 SELFTEST=0
while [ $# -gt 0 ]; do
  case "$1" in
    --fast) FAST=1 ;;
    --full) FULL=1 ;;
    --list) LIST=1 ;;
    --self-test) SELFTEST=1 ;;
    *) echo "unknown option: $1" >&2; exit 2 ;;
  esac
  shift
done

BASE=$(git merge-base origin/main HEAD 2>/dev/null) || BASE=

# The change set the filters read: every path that differs between the
# merge-base and HEAD. Loaded once by load_changed.
CHANGED=

load_changed() {
  if [ -n "$BASE" ]; then
    CHANGED=$(git diff --name-only "$BASE" HEAD -- 2>/dev/null) || CHANGED=
  else
    CHANGED=
  fi
}

# class_changed <class>: exit 0 when a path of that class changed.
#   L  COE and plan lint: docs, the COE tools, the hook README the activation
#      test pins
#   Y  standards YAML: docs and the skill agent cards (the validator scans the
#      whole standards tree whatever changed, so any docs change re-runs it)
#   H  hook suites: hooks
#   T  test-engineering suites: the skill and the validator pins
#   S  skill suite: visual-review
#   W  alphazede-web
#   G  git-sync suite
#   B  baseline checks (always run)
class_changed() {
  case "$1" in
    L) grep -qE '^(docs/|tools/coe/|hooks/README\.md$)' <<<"$CHANGED" ;;
    Y) grep -qE '^(docs/|skills/[^/]+/agents/.*\.ya?ml$)' <<<"$CHANGED" ;;
    H) grep -qE '^hooks/' <<<"$CHANGED" ;;
    T) grep -qE '^(skills/test-engineering/|tools/coe/te-schema-validator-requirements\.txt$)' <<<"$CHANGED" ;;
    S) grep -qE '^skills/visual-review/' <<<"$CHANGED" ;;
    G) grep -qE '^tools/git-sync/' <<<"$CHANGED" ;;
    W) grep -qE '^alphazede-web/' <<<"$CHANGED" ;;
    *) return 1 ;;
  esac
}

class_desc() {
  case "$1" in
    L) echo "COE-lint" ;;
    Y) echo "standards-YAML" ;;
    H) echo "hook" ;;
    T) echo "test-engineering" ;;
    S) echo "skill-suite" ;;
    W) echo "alphazede-web" ;;
    G) echo "git-sync" ;;
    B) echo "baseline" ;;
  esac
}

# RUN_<class> is 1 when that class runs. --full, a missing merge-base, an
# empty change set, or a change to the runner, the validator, or the
# workflows runs every class.
compute_runs() {
  local class
  RUN_B=1
  for class in L Y H T S W G; do
    eval "RUN_$class=0"
  done
  if [ "$FULL" -eq 1 ] || [ -z "$BASE" ] || [ -z "$CHANGED" ]; then
    for class in L Y H T S W G; do
      eval "RUN_$class=1"
    done
    return 0
  fi
  if grep -qE '^(tools/ci/|\.github/workflows/)' <<<"$CHANGED"; then
    for class in L Y H T S W G; do
      eval "RUN_$class=1"
    done
    return 0
  fi
  for class in L Y H T S W G; do
    if class_changed "$class"; then
      eval "RUN_$class=1"
    fi
  done
}

# The isolated Draft 2020-12 validator lives in one directory for the whole
# run; the provision gate installs it and the receipt and Ponytail gates
# import from it. A preset EMV_SCHEMA_VALIDATOR_IMPORTS is reused.
if [ -z "${EMV_SCHEMA_VALIDATOR_IMPORTS:-}" ]; then
  EMV_SCHEMA_VALIDATOR_IMPORTS=$(mktemp -d "${TMPDIR:-/tmp}/te-schema-validator.XXXXXX")
fi
export EMV_SCHEMA_VALIDATOR_IMPORTS

# YAML_PROVISION installs the pinned PyYAML into YAML_VALIDATOR_IMPORTS only
# when the interpreter cannot already import yaml, so a bare hosted runner
# validates the same files the same way. It runs inside the standards-yaml
# gate's own shell, where the export holds for the validator invocation.
YAML_PROVISION='if ! python3 -c "import yaml" 2>/dev/null; then YAML_VALIDATOR_IMPORTS=${YAML_VALIDATOR_IMPORTS:-$(mktemp -d "${TMPDIR:-/tmp}/yaml-validator.XXXXXX")}; python3 -m pip install --isolated --disable-pip-version-check --no-input --no-compile --upgrade-strategy only-if-needed --target "$YAML_VALIDATOR_IMPORTS" --require-hashes --no-deps -r tools/ci/standards-yaml-requirements.txt && export PYTHONPATH="$YAML_VALIDATOR_IMPORTS${PYTHONPATH:+:$PYTHONPATH}"; fi'

# VR_PY prefers the skill venv, which carries Playwright and Chromium (see
# skills/visual-review/SKILL.md), and falls back to the bare interpreter, on
# which the browser tests skip with a reason instead of erroring.
VR_PY='VR_PY=$HOME/.venvs/visual-review/bin/python; if [ ! -x "$VR_PY" ]; then VR_PY=python3; fi'

# name|command|filter|lane|speed
#   filter: B always runs; L Y H T S W G use class_changed above
#   lane:   A the web steps, which share node_modules;
#           B the visual-review browser suite, the one slow gate;
#           C everything else
#   speed:  0 fast, 1 slow (--fast skips the slow gates)
# A command must not contain `|`; the runner splits tuples on it. Spell
# fallbacks as `if` statements, not `||` pipelines.
GATES=(
  "diff-check|git diff --check ${BASE:-HEAD} HEAD|B|C|0"
  "secret-scan|if [ -n \"$BASE\" ]; then OPTS=\"$BASE..HEAD\"; else OPTS=\"HEAD^!\"; fi; gitleaks git --no-banner --redact --log-level warn --log-opts=\"\$OPTS\" .|B|C|0"
  "git-sync|bash tools/git-sync/git-sync.test.sh|G|C|0"
  "web-install|if ! command -v pnpm >/dev/null; then echo 'web-install: pnpm is not on PATH'; exit 127; fi; cd alphazede-web && pnpm install --frozen-lockfile|W|A|0"
  "web-build|cd alphazede-web && pnpm build|W|A|0"
  "web-typecheck|cd alphazede-web && pnpm typecheck|W|A|0"
  "web-test|cd alphazede-web && pnpm test|W|A|0"
  "visual-review|$VR_PY; cd skills/visual-review && \$VR_PY -m unittest discover -s tests|S|B|1"
  "plan-spec-lint|python3 tools/coe/lint-plan-spec.py|L|C|0"
  "sdoc-lint|shopt -s globstar; python3 tools/coe/lint-sdoc.py docs/coe/**/*.sdoc|L|C|0"
  "gate-activation|bash tools/coe/test-pre-commit-gates.sh|L|C|0"
  "standards-yaml|$YAML_PROVISION; python3 tools/ci/validate-standards-yaml.py|Y|C|0"
  "hook-suites|python3 hooks/test-issue-labels.py && bash hooks/test-bug-report-routing.sh && bash hooks/test-merge-gate-guard.sh|H|C|0"
  "te-provision|python3 -m pip install --isolated --disable-pip-version-check --no-input --no-compile --upgrade-strategy only-if-needed --target \"${EMV_SCHEMA_VALIDATOR_IMPORTS}\" --require-hashes --no-deps -r tools/coe/te-schema-validator-requirements.txt|T|C|0"
  "te-evaluator|node --test skills/test-engineering/tests/te-evaluator.test.cjs|T|C|0"
  "te-receipt|python3 skills/test-engineering/tests/te-receipt-contract.test.py|T|C|0"
  "te-ponytail|AZ_PONYTAIL_SKILL=skills/test-engineering/tests/fixtures/ponytail/SKILL.md python3 skills/test-engineering/tests/ponytail-on-off.test.py|T|C|0"
)

# One gate. Prints its line as it finishes and leaves <dir>/<index>.status,
# .line and, on failure, .tail for the ordered summary.
run_gate() { # <index> <dir>
  local name cmd filter lane speed line status t0 out code flag
  IFS='|' read -r name cmd filter lane speed <<<"${GATES[$1]}"
  flag="RUN_$filter"
  if [ "${!flag:-0}" -eq 0 ]; then
    status=N/A line=$(printf 'N/A   %-16s (no %s paths changed since merge-base; --full forces it)' "$name" "$(class_desc "$filter")")
  elif [ "$FAST" -eq 1 ] && [ "$speed" != 0 ]; then
    status=SKIP line=$(printf 'SKIP  %-16s (--fast)' "$name")
  else
    t0=$(date +%s)
    # A hung gate is a failed gate.
    out="$2/$1.out"
    # The wrapper records its process group before starting the gate, so an
    # interrupt can stop the whole group even during the launch race.
    trap 'lane_interrupted=130' INT
    trap 'lane_interrupted=143' TERM
    [ -z "$lane_interrupted" ] || exit "$lane_interrupted"
    setsid bash -c 'echo "$$" >"$1"; exec timeout --foreground "$2" bash -c "$3"' \
      _ "$2/gate.$lane.pid" "${GATE_TIMEOUT:-600}" "$cmd" >"$out" 2>&1 &
    gate_pid=$!
    [ -z "$lane_interrupted" ] || exit "$lane_interrupted"
    trap 'exit 130' INT
    trap 'exit 143' TERM
    [ -z "$lane_interrupted" ] || exit "$lane_interrupted"
    if wait "$gate_pid"; then
      status=PASS line=$(printf 'PASS  %-16s %4ss' "$name" "$(( $(date +%s) - t0 ))")
