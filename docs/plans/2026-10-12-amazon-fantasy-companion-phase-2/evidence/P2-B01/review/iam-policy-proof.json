{
  "tool": "installed SAM CLI 1.169.0 policy template data (offline; no AWS)",
  "policy_data_sha256": "3da6e0e839d44360b0f68d0d15f5962e709099e7b398f035a062e82c9f27ed89",
  "DynamoDBCrudPolicy": {
    "Definition": {
      "Statement": [
        {
          "Action": [
            "dynamodb:GetItem",
            "dynamodb:DeleteItem",
            "dynamodb:PutItem",
            "dynamodb:Scan",
            "dynamodb:Query",
            "dynamodb:UpdateItem",
            "dynamodb:BatchWriteItem",
            "dynamodb:BatchGetItem",
            "dynamodb:DescribeTable",
            "dynamodb:ConditionCheckItem"
          ],
          "Effect": "Allow",
          "Resource": [
            {
              "Fn::Sub": [
                "arn:${AWS::Partition}:dynamodb:${AWS::Region}:${AWS::AccountId}:table/${tableName}",
                {
                  "tableName": {
                    "Ref": "TableName"
                  }
                }
              ]
            },
            {
              "Fn::Sub": [
                "arn:${AWS::Partition}:dynamodb:${AWS::Region}:${AWS::AccountId}:table/${tableName}/index/*",
                {
                  "tableName": {
                    "Ref": "TableName"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    "Description": "Gives CRUD access to a DynamoDB Table",
    "Parameters": {
      "TableName": {
        "Description": "Name of the DynamoDB Table"
      }
    }
  },
  "DynamoDBReadPolicy": {
    "Definition": {
      "Statement": [
        {
          "Action": [
            "dynamodb:GetItem",
            "dynamodb:Scan",
            "dynamodb:Query",
            "dynamodb:BatchGetItem",
            "dynamodb:DescribeTable"
          ],
          "Effect": "Allow",
          "Resource": [
            {
              "Fn::Sub": [
                "arn:${AWS::Partition}:dynamodb:${AWS::Region}:${AWS::AccountId}:table/${tableName}",
                {
                  "tableName": {
                    "Ref": "TableName"
                  }
                }
              ]
            },
            {
              "Fn::Sub": [
                "arn:${AWS::Partition}:dynamodb:${AWS::Region}:${AWS::AccountId}:table/${tableName}/index/*",
                {
                  "tableName": {
                    "Ref": "TableName"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    "Description": "Gives read only access to a DynamoDB Table",
    "Parameters": {
      "TableName": {
        "Description": "Name of the DynamoDB Table"
      }
    }
  }
}
